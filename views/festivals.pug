extends layout

block content
  h1= title

  -
    let items = results

  div.container-fluid
    div.row
      each item, index in items
        div.col-sm-2(
          onclick=`alert('You selected item number ${index + 1}')`
          style="cursor: pointer; border: 1px solid #ccc; padding: 10px; margin: 5px;"
        )
          p Festival: #{item.name}
          p Location: #{item.location}
          p Date: #{item.date}